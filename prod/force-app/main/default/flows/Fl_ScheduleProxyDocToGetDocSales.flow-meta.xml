  &quot;Brouillon&quot;,
  &quot;Actif&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Flm_CompteId</name>
        <dataType>String</dataType>
        <expression>IF(
 NOT(ISBLANK({!GetCompte_Exact.Id})), {!GetCompte_Exact.Id},
 IF(NOT(ISBLANK({!GetCompte_SansZero.Id})), {!GetCompte_SansZero.Id},
 {!GetCompte_ViaProxy.Id})
)</expression>
    </formulas>
    <formulas>
        <name>Flm_TextAdress_SansZero</name>
        <dataType>String</dataType>
        <expression>IF(
 AND(NOT(ISBLANK({!$Record.TextAdress__c})), REGEX({!$Record.TextAdress__c}, &quot;[0-9]+&quot;)),
 TEXT(VALUE({!$Record.TextAdress__c})),
 {!$Record.TextAdress__c}
)</expression>
    </formulas>
    <formulas>
        <name>FlmDocDebSuppr</name>
        <dataType>String</dataType>
        <expression>IF(
{!$Record.DOC_DEB_Doc_suppr__c}= 0,
