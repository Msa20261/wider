<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Email_Contact</name>
        <label>Envoyer Email Contact</label>
        <locationX>176</locationX>
        <locationY>755</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Contact.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>frmlCorpsEmailContact</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>frmlObjetEmailContact</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>cLineBreak</name>
        <dataType>String</dataType>
        <value>
            <stringValue>
</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Decision_Est_Contact</name>
        <label>Le Name (WhoId) est-il un Contact ?</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Non (Lead ou vide)</defaultConnectorLabel>
        <rules>
            <name>Oui_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmlEstUnContact</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Email_Valide</name>
        <label>Le Contact a-t-il un email ?</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Non</defaultConnectorLabel>
        <rules>
            <name>Oui_Email_Valide</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmlContactEmailValide</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Contact</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frmlContactEmailValide</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Contact.Email}))</expression>
    </formulas>
    <formulas>
        <name>frmlCorpsEmailContact</name>
        <dataType>String</dataType>
        <expression>&quot;Une tache vous a ete attribuee !&quot; &amp; {!cLineBreak} &amp; {!cLineBreak} &amp;
&quot;Projet : &quot; &amp; {!frmlNomProjet} &amp; {!cLineBreak} &amp;
&quot;Detail : &quot; &amp; IF(ISBLANK({!$Record.Description}), &quot;-&quot;, {!$Record.Description}) &amp; {!cLineBreak} &amp;
&quot;Date : &quot; &amp; IF(ISBLANK(TEXT({!$Record.ActivityDate})), &quot;-&quot;, TEXT({!$Record.ActivityDate})) &amp; {!cLineBreak} &amp;
{!cLineBreak} &amp;
&quot;Cordialement,&quot; &amp; {!cLineBreak} &amp;
&quot;L&apos;equipe Wider&quot; &amp; {!cLineBreak} &amp; {!cLineBreak} &amp;
&quot;Ceci est un message automatique, merci de ne pas y repondre directement.&quot;</expression>
    </formulas>
    <formulas>
        <name>frmlEstUnContact</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.WhoId})), LEFT({!$Record.WhoId}, 3) = &quot;003&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmlNomProjet</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Projet.Name}), &quot;-&quot;, {!Get_Projet.Name})</expression>
    </formulas>
    <formulas>
        <name>frmlObjetEmailContact</name>
        <dataType>String</dataType>
        <expression>&quot;Attribution de tache : &quot; &amp; IF(ISBLANK({!$Record.Subject}), &quot;-&quot;, {!$Record.Subject}) &amp; &quot; pour &quot; &amp; IF(ISBLANK(TEXT({!$Record.Type_de_t_che__c})), &quot;-&quot;, TEXT({!$Record.Type_de_t_che__c}))</expression>
    </formulas>
    <interviewLabel>Projet Notification Attribution {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Projet Notification Attribution</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Recuperer le Contact</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Email_Valide</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Projet</name>
        <label>Recuperer le Projet</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Est_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Projet__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Projet</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
