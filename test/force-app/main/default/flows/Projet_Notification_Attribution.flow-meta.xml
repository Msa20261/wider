    <constants>
        <name>cLineBreak</name>
        <dataType>String</dataType>
        <value>
            <stringValue>
</stringValue>
        </value>
    </constants>
    <environments>Default</environments>
    <formulas>
        <name>frmlCorpsEmail</name>
        <dataType>String</dataType>
        <expression>&quot;Une tache vous a ete attribuee !&quot; &amp; {!cLineBreak} &amp; {!cLineBreak} &amp;
&quot;Projet : &quot; &amp; {!$Record.Name} &amp; {!cLineBreak} &amp;
&quot;Compte : &quot; &amp; IF(ISBLANK({!$Record.Nom_du_compte__c}), &quot;-&quot;, {!$Record.Nom_du_compte__r.Name}) &amp; {!cLineBreak} &amp;
IF({!$Record.Montant__c} &lt;&gt; 0, &quot;Montant estimatif : &quot; &amp; TEXT({!$Record.Montant__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_Calculation_net_avec_provisio__c} &lt;&gt; 0, &quot;Calculation PR (avec provisions) : &quot; &amp; TEXT({!$Record.Montant_Calculation_net_avec_provisio__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_Calculation_net_sans_provision__c} &lt;&gt; 0, &quot;Calculation PR (sans provisions) : &quot; &amp; TEXT({!$Record.Montant_Calculation_net_sans_provision__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_Correction_confirm__c} &lt;&gt; 0, &quot;Correction Confirme : &quot; &amp; TEXT({!$Record.Montant_Correction_confirm__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_Paiement_client_recevoir__c} &lt;&gt; 0, &quot;A recevoir : &quot; &amp; TEXT({!$Record.Montant_Paiement_client_recevoir__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_Potentiel_facturation__c} &lt;&gt; 0, &quot;Potentiel facturation : &quot; &amp; TEXT({!$Record.Montant_Potentiel_facturation__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_S_trait_ext__c} &lt;&gt; 0, &quot;Montant S-trait ext. : &quot; &amp; TEXT({!$Record.Montant_S_trait_ext__c}) &amp; {!cLineBreak}, &quot;&quot;) &amp;
IF({!$Record.Montant_S_trait_int__c} &lt;&gt; 0, &quot;Montant S-trait int. : &quot; &amp; TEXT({!$Record.Montant_S_trait_int__c}) &amp; {!cLineBreak}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmlEstTransitionAttributionOuvert</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Etape__c}), PRIORVALUE({!$Record.Etape__c}) = &quot;Attribution&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmlObjetEmail</name>
        <dataType>String</dataType>
        <expression>&quot;Une tache vous a ete attribuee - &quot; &amp; {!$Record.Name}</expression>
    </formulas>
