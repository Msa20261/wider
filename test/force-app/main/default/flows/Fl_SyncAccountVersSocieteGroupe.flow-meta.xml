<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>Flm_Rue</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Adresse_compte__Street__s})), {!$Record.Adresse_compte__Street__s},
IF(NOT(ISBLANK({!$Record.BillingStreet})), {!$Record.BillingStreet}, {!$Record.ShippingStreet}))</expression>
    </formulas>
    <formulas>
        <name>Flm_CodePostal</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Adresse_compte__PostalCode__s})), {!$Record.Adresse_compte__PostalCode__s},
IF(NOT(ISBLANK({!$Record.BillingPostalCode})), {!$Record.BillingPostalCode}, {!$Record.ShippingPostalCode}))</expression>
    </formulas>
    <formulas>
        <name>Flm_Ville</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Adresse_compte__City__s})), {!$Record.Adresse_compte__City__s},
IF(NOT(ISBLANK({!$Record.BillingCity})), {!$Record.BillingCity}, {!$Record.ShippingCity}))</expression>
    </formulas>
    <formulas>
        <name>Flm_Pays</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK(TEXT({!$Record.Adresse_compte__CountryCode__s}))), TEXT({!$Record.Adresse_compte__CountryCode__s}),
IF(NOT(ISBLANK({!$Record.BillingCountry})), {!$Record.BillingCountry}, {!$Record.ShippingCountry}))</expression>
    </formulas>
    <interviewLabel>Fl_SyncAccountVersSocieteGroupe {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fl_SyncAccountVersSocieteGroupe</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateSocieteGroupe</name>
        <label>Update Societe Groupe</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Compte_Associe__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>TVA__c</field>
            <value>
                <elementReference>$Record.Numero_TVA__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TVA_intra_communautaire__c</field>
            <value>
                <elementReference>$Record.No_TVA_EU__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>T_l_phone__c</field>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Site_web__c</field>
            <value>
                <elementReference>$Record.Website</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Complement_d_adresse__c</field>
            <value>
                <elementReference>$Record.Supplement_adresse__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rue__c</field>
            <value>
                <elementReference>Flm_Rue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Code_postal__c</field>
            <value>
                <elementReference>Flm_CodePostal</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ville__c</field>
            <value>
                <elementReference>Flm_Ville</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pays__c</field>
            <value>
                <elementReference>Flm_Pays</elementReference>
            </value>
        </inputAssignments>
        <object>Soci_t_du_groupe__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>UpdateSocieteGroupe</targetReference>
        </connector>
        <filterFormula>AND(
OR(
{!$Record.Identification__c} = &quot;1000&quot;,
{!$Record.Identification__c} = &quot;2000&quot;,
{!$Record.Identification__c} = &quot;3000&quot;,
{!$Record.Identification__c} = &quot;4000&quot;,
{!$Record.Identification__c} = &quot;7000&quot;,
{!$Record.Identification__c} = &quot;9000&quot;
),
OR(
ISCHANGED({!$Record.Adresse_compte__Street__s}),
ISCHANGED({!$Record.Adresse_compte__City__s}),
ISCHANGED({!$Record.Adresse_compte__PostalCode__s}),
ISCHANGED({!$Record.Numero_TVA__c}),
ISCHANGED({!$Record.No_TVA_EU__c}),
ISCHANGED({!$Record.Phone}),
ISCHANGED({!$Record.Website}),
ISCHANGED({!$Record.Supplement_adresse__c}),
ISCHANGED({!$Record.BillingStreet}),
ISCHANGED({!$Record.BillingPostalCode}),
ISCHANGED({!$Record.BillingCity}),
ISCHANGED({!$Record.BillingCountry}),
ISCHANGED({!$Record.ShippingStreet}),
ISCHANGED({!$Record.ShippingPostalCode}),
ISCHANGED({!$Record.ShippingCity}),
ISCHANGED({!$Record.ShippingCountry})
)
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
